# ============================================================
# Git for Research — Environment Variable Template
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to Git.
# This file (.env.example) is safe to commit — it contains NO secrets.
# ============================================================

# --- Supabase (PostgreSQL + Storage) ---
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (Embeddings + grounded research answers) ---
# Found in: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional; defaults to gpt-6-luna.
OPENAI_ANSWER_MODEL=
